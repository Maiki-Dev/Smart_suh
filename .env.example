# Supabase (Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Supabase database password (Dashboard → Project Settings → Database)
SUPABASE_DB_PASSWORD=your-database-password

# Session pooler host — Dashboard → Connect → Transaction mode
# Жишээ: aws-0-ap-northeast-2.pooler.supabase.com
# Windows/local dev-д ЗААВАЛ хэрэгтэй (direct db.*.supabase.co нь IPv6-only)
SUPABASE_POOLER_HOST=aws-0-REGION.pooler.supabase.com

# Pooler port: 6543 = Transaction (default, Next.js-д зөвлөмж), 5432 = Session
# SUPABASE_POOLER_PORT=6543

# Next.js-д Transaction pooler (port 6543) илүү тохиромжтой — холболтын хязgaar их, serverless-friendly
# Dashboard → Connect → Transaction mode → URI
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-REGION.pooler.supabase.com:6543/postgres

# Session pooler (port 5432) ашиглаж байвал pool-ийг бага байлгана (Supabase ≈15 холболт)
# DATABASE_POOL_MAX=1

# SUPER_ADMIN нэвтрэхэд анхны байгууллага (заавал биш — DB-ээс автоматаар авна)
# DEFAULT_ORGANIZATION_ID=

# Эсвэл Connect → Session pooler URI-ийг шууд хуулж болно:
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-REGION.pooler.supabase.com:5432/postgres

# Vercel Cron → GET /api/cron/generate-invoices (Authorization: Bearer <secret>)
CRON_SECRET=generate-a-long-random-secret

# Wire.mn төлбөрийн гарца
WIRE_MN_API_KEY=your-wire-mn-api-key
WIRE_MN_PAYMENT_LINK=https://pay.wire.mn/link/your-payment-link-id
# Wire dashboard → Webhooks → whsec_… (зөвхөн нэг удаа харагдана)
WIRE_MN_WEBHOOK_SECRET=whsec_your_webhook_secret
# Нийтийн HTTPS URL — Wire webhook болон success redirect-д заавал
# Жишээ: https://your-app.vercel.app  (localhost дээр webhook ажиллахгүй!)
NEXT_PUBLIC_APP_URL=https://your-site.example.com
